# ============================================================
# Cocos Creator 3.8 工程
# ============================================================
# 编辑器导入资源后生成的缓存：体积大，可随时重建
/library/
# 构建与编译中间产物
/temp/
# 编辑器本地配置（窗口布局、最近打开记录等），因人而异
/local/
# 构建输出目录
/build/
# 编辑器 / 构建插件的本地配置
/profiles/
# 构建原生平台时生成的原生工程模板
/native/

# ⚠️ 注意：assets/ 与 settings/ 目录下的 *.meta 文件【必须提交】，
#    它们保存了资源 uuid，丢失会导致场景、预制体、脚本引用全部失效。
#    同理请不要忽略 settings/、build-templates/、extensions/。

# ============================================================
# 依赖
# ============================================================
/node_modules/
/extensions/*/node_modules/

# ============================================================
# 构建 / 缓存 / 日志
# ============================================================
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# 操作系统
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# 编辑器 / IDE（由工具自动生成，可按需取消忽略）
# ============================================================
.vscode/
.idea/
*.code-workspace
*.swp
*~